---
import { ArrowUpRight } from 'lucide-astro';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { LocalizedEntry } from '@/lib/i18n-content';

interface Props {
  locale: Lang;
  projects: LocalizedEntry[];
}
const { locale, projects } = Astro.props;
const t = useTranslations(locale);
---
<section class="content-section projects-section" id="projects">
  <div class="section-wrap">
    <div class="section-heading light-heading">
      <div><p class="eyebrow">{t('projects.eyebrow')}</p><h2>{t('projects.heading')}</h2></div>
      <a class="view-all" href={localizePath('/projects/', locale)}>{t('projects.viewAll')} <ArrowUpRight /></a>
    </div>
    <div class="project-grid searchable-group">
      {projects.map(({ entry, title, description }) => <a class="project-card searchable-item" data-search={`${title} ${description} ${entry.data.label ?? ''}`} href={localizePath(`/projects/${entry.id.replace(/\.md$/, '')}/`, locale)}>
        <div class={`project-visual visual-${entry.data.visual}`}>
          {entry.data.image ? <img src={entry.data.image} alt={`${title}`} loading="lazy" width="900" height="600" /> : <span class="game-fallback-mark">{title}</span>}
        </div>
        <div class="project-info"><div><span class="project-type">{entry.data.label}</span><h3>{title}</h3><p>{description}</p></div><ArrowUpRight /></div>
      </a>)}
    </div>
  </div>
</section>
