---
import { ArrowUpRight, BookOpen, Film, Gamepad2, Music } from 'lucide-astro';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { LocalizedEntry } from '@/lib/i18n-content';
import { formatMediaTitle, getMediaTone, type MediaTone } from '@/lib/media';

interface Props {
  locale: Lang;
  media: LocalizedEntry[];
}
const { locale, media } = Astro.props;
const t = useTranslations(locale);
const iconMap = { book: BookOpen, screen: Film, music: Music, game: Gamepad2 };
const typeLabelsZh = { book: '书籍', screen: '影视剧', music: '音乐', game: '游戏' };
const typeLabelsEn = { book: 'Book', screen: 'Screen', music: 'Music', game: 'Game' };
const typeLabels = locale === 'en' ? typeLabelsEn : typeLabelsZh;
const statusMap: Record<string, string> = locale === 'en'
  ? { '已经看': 'Watched', '正在看': 'Watching', '将要看': 'Planned' }
  : { '已经看': '已经看', '正在看': '正在看', '将要看': '将要看' };
const statusClass: Record<string, string> = { '已经看': 'done', '正在看': 'current', '将要看': 'next' };
const tones: MediaTone[] = ['blue', 'yellow', 'pink', 'green'];
---
<section class="content-section media-library-section" id="library">
  <div class="section-wrap">
    <div class="section-heading">
      <div><p class="eyebrow">{t('media.eyebrow')}</p><h2>{t('media.heading')}</h2></div>
      <a class="view-all" href={localizePath('/library/', locale)}>{t('media.viewAll')} <ArrowUpRight /></a>
    </div>
    <p class="media-library-lede">{t('media.intro')}</p>
    {media.length > 0 ? <div class="media-library-grid searchable-group">
      {media.slice(0, 6).map(({ entry, title, description, status, creator }, index) => { const type = entry.data.mediaType ?? 'book'; const Icon = iconMap[type]; const tone = getMediaTone(entry.data.color ?? tones[index % tones.length]); return <a class={`media-card media-${type} media-tone-${tone} searchable-item`} data-search={`${title} ${description} ${entry.data.creator ?? ''} ${entry.data.status ?? ''}`} href={entry.data.url ?? localizePath('/library/', locale)} target={entry.data.url ? '_blank' : undefined} rel={entry.data.url ? 'noreferrer' : undefined}>
        <div class="media-card-head"><div class="media-card-mark"><Icon /></div><div class="media-card-tags"><span class={`media-type-badge media-type-badge-${type}`}>{typeLabels[type]}</span>{entry.data.status && <><span class="media-tag-separator">·</span><span class={`media-status media-status-${statusClass[entry.data.status] ?? 'next'}`}>{statusMap[entry.data.status] ?? status ?? entry.data.status}</span></>}</div></div><div class="media-card-copy"><h3>{formatMediaTitle(title, type, locale)}</h3><p>{description}</p>{entry.data.creator && <small class="media-creator">{creator ?? entry.data.creator}</small>}</div>{entry.data.rating !== undefined && <span class="media-rating">{'★'.repeat(Math.round(entry.data.rating))}</span>}<ArrowUpRight />
      </a>; })}
    </div> : <a class="media-empty" href={localizePath('/library/', locale)}><span class="media-card-mark"><BookOpen /></span><div><span class="eyebrow">YOUR LIBRARY</span><h3>{t('media.heading')}</h3><p>{t('media.intro')}</p></div><ArrowUpRight /></a>}
  </div>
</section>
