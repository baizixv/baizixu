---
import { ArrowUpRight } from 'lucide-astro';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { LocalizedEntry } from '@/lib/i18n-content';

interface Props {
  locale: Lang;
  articles: LocalizedEntry[];
}
const { locale, articles } = Astro.props;
const t = useTranslations(locale);
const featured = articles.find(({ entry }) => entry.data.featured) ?? articles[0];
const others = articles.filter(({ entry }) => entry.id !== featured?.entry.id).slice(0, 3);
const formatDate = (date: Date) => date.toISOString().slice(5, 10).replace('-', '.');
---
<section class="content-section section-wrap" id="writing">
  <div class="section-heading">
    <div><p class="eyebrow">{t('writing.eyebrow')}</p><h2>{t('writing.heading')}</h2></div>
    <a class="view-all" href={localizePath('/articles/', locale)}>{t('writing.viewAll')} <ArrowUpRight /></a>
  </div>
  {featured && <div class="content-grid searchable-group">
    <article class="writing-feature searchable-item" data-search={`${featured.title} ${featured.description} ${featured.entry.data.tag ?? ''}`}>
      <div class="article-meta"><span class={`tag tag-${featured.entry.data.color ?? 'blue'}`}>{featured.entry.data.tag}</span><span class="mono">{formatDate(featured.entry.data.date)} · {featured.entry.data.minutes}</span></div>
      <h3>{featured.title}</h3>
      <p>{featured.description}</p>
      <a class="circle-link" href={localizePath(`/articles/${featured.entry.id.replace(/\.md$/, '')}/`, locale)} aria-label={featured.title}><ArrowUpRight /></a>
    </article>
    <div class="article-list">
      {others.map(({ entry, title, description }) => <a class="article-row searchable-item" data-search={`${title} ${description} ${entry.data.tag ?? ''}`} href={localizePath(`/articles/${entry.id.replace(/\.md$/, '')}/`, locale)}>
        <div><span class={`tag tag-${entry.data.color ?? 'blue'}`}>{entry.data.tag}</span><h3>{title}</h3><p>{description}</p></div><span class="mono">{formatDate(entry.data.date)}</span><ArrowUpRight />
      </a>)}
    </div>
  </div>}
</section>
