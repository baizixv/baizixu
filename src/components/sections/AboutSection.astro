---
import { ArrowUpRight, Mail } from 'lucide-astro';
import { getAbout } from '@/data/about';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const about = getAbout(locale);
---
<section class="about-preview content-section section-wrap" id="about">
  <div class="about-preview-copy">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h2>{t('about.heading')}<br /><em>{t('about.headingAccent')}</em></h2>
    <p>{about.intro}</p>
    <a class="view-all" href={localizePath('/about/', locale)}>{t('about.more')} <ArrowUpRight /></a>
  </div>
  <div class="about-preview-card">
    <div class="about-avatar">B</div>
    <div class="about-preview-info"><span class="project-type">{about.role}</span><strong>{about.location}</strong><small>{about.availability}</small></div>
    <a class="about-contact" href={`mailto:${about.email}`} aria-label={t('about.sendMail')}><Mail /></a>
  </div>
</section>
