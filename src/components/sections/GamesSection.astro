---
import { ArrowUpRight, Gamepad2 } from 'lucide-astro';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { LocalizedEntry } from '@/lib/i18n-content';

interface Props {
  locale: Lang;
  games: LocalizedEntry[];
}
const { locale, games } = Astro.props;
const t = useTranslations(locale);
---
<section class="content-section games-section" id="games">
  <div class="section-wrap">
    <div class="section-heading games-heading">
      <div><p class="eyebrow">{t('games.eyebrow')}</p><h2>{t('games.heading')}</h2></div>
      <a class="view-all" href={localizePath('/games/', locale)}>{t('games.viewAll')} <ArrowUpRight /></a>
    </div>
    <div class="games-intro">
      <div class="games-symbol"><Gamepad2 /></div>
      <p>{t('games.intro')}</p>
    </div>
    <div class="game-grid searchable-group">
      {games.map(({ entry, title, description, label }) => <a class="game-card searchable-item" data-search={`${title} ${description} ${entry.data.label ?? ''}`} href={localizePath(`/games/${entry.id.replace(/\.md$/, '')}/`, locale)}>
        <div class={`project-visual visual-${entry.data.visual}`}>
          {entry.data.image ? <img src={entry.data.image} alt={`${title}`} loading="lazy" width="900" height="600" /> : <span class="game-fallback-mark">PLAY</span>}
          <span class="game-play"><Gamepad2 /> {t('games.play')} <ArrowUpRight /></span>
        </div>
        <div class="game-info"><div><span class="project-type">{label ?? entry.data.label}</span><h3>{title}</h3><p>{description}</p></div><ArrowUpRight /></div>
      </a>)}
    </div>
  </div>
</section>
