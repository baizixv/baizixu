---
import { ArrowUpRight, Lightbulb, Sparkles } from 'lucide-astro';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { LocalizedEntry } from '@/lib/i18n-content';

interface Props {
  locale: Lang;
  ideas: LocalizedEntry[];
}
const { locale, ideas } = Astro.props;
const t = useTranslations(locale);
const statusMap: Record<string, string> = locale === 'en'
  ? { '想法萌芽': 'Seed', '推敲中': 'Drafting', '准备实现': 'Ready', '实现中': 'Building', '已实现': 'Done' }
  : {};
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
const fallbackStatus = locale === 'en' ? 'Seed' : '想法萌芽';
---
<section class="content-section ideas-section" id="ideas">
  <div class="section-wrap">
    <div class="section-heading ideas-heading">
      <div><p class="eyebrow">{t('ideas.eyebrow')}</p><h2>{t('ideas.heading')}</h2></div>
      <a class="view-all" href={localizePath('/ideas/', locale)}>{t('ideas.viewAll')} <ArrowUpRight /></a>
    </div>
    <div class="ideas-intro">
      <Sparkles />
      <p>{t('ideas.intro')}</p>
    </div>
    {ideas.length > 0 ? <div class="ideas-grid searchable-group">
      {ideas.slice(0, 4).map(({ entry, title, description, status }, index) => <a class={`idea-card idea-tone-${entry.data.color ?? 'yellow'} searchable-item`} data-search={`${title} ${description} ${entry.data.status ?? ''}`} href={localizePath(`/ideas/${entry.id.replace(/\.md$/, '')}/`, locale)}>
        <div class="idea-card-top"><span>{String(index + 1).padStart(2, '0')}</span><span class="idea-status">{statusMap[entry.data.status ?? ''] ?? status ?? entry.data.status ?? fallbackStatus}</span></div>
        <h3>{title}</h3><p>{description}</p>
        <div class="idea-card-foot"><span>{formatDate(entry.data.date)}</span><ArrowUpRight /></div>
      </a>)}
    </div> : <a class="ideas-empty" href={localizePath('/ideas/', locale)}>
      <span class="ideas-empty-icon"><Lightbulb /></span>
      <div><span class="eyebrow">IDEA SEED</span><h3>{t('ideas.empty.title')}</h3><p>{t('ideas.empty.body')}</p></div>
      <ArrowUpRight />
    </a>}
  </div>
</section>
