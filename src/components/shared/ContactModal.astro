---
import { ArrowUpRight, Mail, X } from 'lucide-astro';
import { getAbout } from '@/data/about';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale?: Lang;
}
const { locale = 'zh' } = Astro.props;
const t = useTranslations(locale);
const about = getAbout(locale);
---
<div class="contact-modal" id="contact-modal" data-copied-label={t('contact.copied')} data-copy-label={t('contact.copy')} hidden>
  <div class="contact-modal-card" role="dialog" aria-modal="true" aria-label={t('contact.heading')}>
    <button class="icon-button contact-close" id="contact-close" type="button" aria-label={t('contact.close')}>
      <X aria-hidden="true" />
    </button>
    <p class="eyebrow">{t('contact.eyebrow')}</p>
    <h3>{t('contact.heading')}</h3>
    <p class="contact-note">{about.availability}</p>
    <div class="contact-row">
      <span class="contact-label">{t('contact.email')}</span>
      <code class="contact-value" data-copy={about.email}>{about.email}</code>
      <button class="contact-copy" type="button" data-copy={about.email}>{t('contact.copy')}</button>
    </div>
    <div class="contact-row">
      <span class="contact-label">GitHub</span>
      <a class="contact-value" href={about.github} target="_blank" rel="noreferrer">@baizixv</a>
    </div>
    <div class="contact-row">
      <span class="contact-label">{t('contact.location')}</span>
      <span class="contact-value">{about.location}</span>
    </div>
    <a class="button button-dark contact-mail" href={`mailto:${about.email}`}>
      <Mail aria-hidden="true" />{t('contact.send')} <ArrowUpRight aria-hidden="true" />
    </a>
  </div>
</div>
