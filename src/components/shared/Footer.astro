---
import { ArrowUp, ArrowUpRight, Mail } from 'lucide-astro';
import { about } from '@/data/about';

const year = new Date().getFullYear();
---
<section class="closing section-wrap">
  <div><p class="eyebrow">KEEP IN TOUCH</p><h2>有新的想法，<br /><em>就写信给我。</em></h2></div>
  <a class="mail-button" href={`mailto:${about.email}`}><Mail /><span>{about.email}</span><ArrowUpRight /></a>
</section>
<footer class="footer section-wrap">
  <span>© {year} 白子诩<a class="footer-record" href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">豫ICP备2026044694号-1</a></span>
  <span>MADE WITH CURIOSITY <b>✳</b></span>
  <a href="#top">回到顶部 <ArrowUp /></a>
</footer>
