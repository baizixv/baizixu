---
import { ArrowUp, ArrowUpRight, Mail } from 'lucide-astro';
import { getAbout } from '@/data/about';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale?: Lang;
}
const { locale = 'zh' } = Astro.props;
const t = useTranslations(locale);
const about = getAbout(locale);
const year = new Date().getFullYear();
---
<section class="closing section-wrap">
  <div><p class="eyebrow">KEEP IN TOUCH</p><h2>{t('footer.closing')}<br /><em>{t('footer.closingAccent')}</em></h2></div>
  <a class="mail-button" href={`mailto:${about.email}`}><Mail /><span>{about.email}</span><ArrowUpRight /></a>
</section>
<footer class="footer section-wrap">
  <div class="footer-main">
    <span>© {year} {about.name}</span>
    <span>{t('footer.made')} <b>✳</b></span>
    <a href="#top">{t('footer.top')} <ArrowUp /></a>
  </div>
  <div class="footer-records">
    <a class="footer-record" href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{t('footer.records')}</a>
  </div>
</footer>
