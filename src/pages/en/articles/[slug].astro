---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';
import { useTranslations } from '@/i18n/utils';
import { localizeEntry } from '@/lib/i18n-content';

export async function getStaticPaths() {
  const articles = await getCollection('entries', ({ data }) => data.kind === 'article');
  return articles.map((article) => ({ params: { slug: article.id.replace(/\.md$/, '') }, props: { article } }));
}

const { article } = Astro.props;
const locale = 'en' as const;
const t = useTranslations(locale);
const localized = await localizeEntry(article, locale);
const { Content } = await render(localized.translation ?? article);
---
<Layout title={`${localized.title} · Baizixu`} description={localized.description}>
  <main class="detail-page section-wrap">
    <a class="back-link" href="/en/"><ArrowLeft /> {t('back.home')}</a>
    <article class="detail-article">
      <div class="article-meta"><span class={`tag tag-${article.data.color ?? 'blue'}`}>{article.data.tag}</span><span class="mono">{article.data.date.toISOString().slice(0, 10)} · {article.data.minutes}</span></div>
      <h1>{localized.title}</h1>
      <p class="detail-lede">{localized.description}</p>
      <div class="detail-body"><Content /></div>
    </article>
    <a class="next-link" href="/en/#writing">{t('articles.more')} <ArrowUpRight /></a>
  </main>
</Layout>
