---
import { ArrowLeft, ArrowUpRight, BookOpen, Film, Gamepad2, Music } from 'lucide-astro';
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { useTranslations } from '@/i18n/utils';
import { localizeEntries } from '@/lib/i18n-content';
import { formatMediaTitle, formatWordCount, getMediaTone, type MediaTone } from '@/lib/media';

const locale = 'en' as const;
const t = useTranslations(locale);
const media = (await getCollection('entries', ({ data }) => data.kind === 'media')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = await localizeEntries(media, locale);
const tones: MediaTone[] = ['blue', 'yellow', 'pink', 'green'];
const statusLabels: Record<string, string> = { '已经看': t('library.watched'), '正在看': t('library.watching'), '将要看': t('library.planned') };
const statuses = ['正在看', '将要看', '已经看'] as const;
const groups = [
  { type: 'book' as const, label: 'Books', icon: BookOpen },
  { type: 'screen' as const, label: 'Screen', icon: Film },
  { type: 'music' as const, label: 'Music', icon: Music },
  { type: 'game' as const, label: 'Games', icon: Gamepad2 }
];
---
<Layout title={t('library.title')} description={t('library.desc')}>
  <main class="archive-page library-page section-wrap">
    <a class="back-link" href="/en/"><ArrowLeft /> {t('back.home')}</a>
    <div class="archive-heading"><p class="eyebrow">{t('media.eyebrow')}</p><h1>{t('media.heading')}</h1><p>{t('library.desc')}</p></div>
    <div class="library-catalog">
      {groups.map(({ type, label, icon: Icon }) => { const groupItems = items.filter(({ entry }) => entry.data.mediaType === type); return <section class="library-catalog-group"><div class="library-catalog-heading"><span class="library-catalog-icon"><Icon /></span><div><span class="eyebrow">{type.toUpperCase()}</span><h2>{label}</h2></div><span class="library-count">{groupItems.length}</span></div>{groupItems.length > 0 ? <div class="library-status-groups">{statuses.map((status) => { const statusItems = groupItems.filter(({ entry }) => entry.data.status === status); return <section class={`library-status-group library-status-group-${status === '已经看' ? 'done' : status === '正在看' ? 'current' : 'next'}`}><div class="library-status-heading"><span>{statusLabels[status]}</span><small>{statusItems.length}</small></div>{statusItems.length > 0 ? <div class="library-catalog-list">{statusItems.map(({ entry, title, description, label }, index) => <a class={`library-catalog-item media-tone-${getMediaTone(entry.data.color ?? tones[index % tones.length])}`} href={entry.data.url ?? '#'} target={entry.data.url ? '_blank' : undefined} rel={entry.data.url ? 'noreferrer' : undefined}><div><h3>{formatMediaTitle(title, type, locale)}</h3><p>{entry.data.creator ? `${entry.data.creator} · ` : ''}{description}</p></div><div class="library-item-meta">{label && <span class="library-label">{label}</span>}{formatWordCount(entry.data.wordCount, locale) && <span>{formatWordCount(entry.data.wordCount, locale)}</span>}{entry.data.year && <span>{entry.data.year}</span>}{entry.data.rating !== undefined && <span>{'★'.repeat(Math.round(entry.data.rating))}</span>}<ArrowUpRight /></div></a>)}</div> : <p class="library-status-empty">{t('library.none')}</p>}</section>; })}</div> : <p class="library-catalog-empty">{t('library.empty')}</p>}</section>; })}
    </div>
  </main>
</Layout>
