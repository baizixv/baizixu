---
import { Check, Download, Globe, Moon, Palette, Search, Sun } from 'lucide-astro';
import ContactModal from '@/components/shared/ContactModal.astro';
import { themes, defaultTheme } from '@/data/themes';
import { defaultLang, languages, type Lang } from '@/i18n/ui';
import { localizePath, switchLangPath, useTranslations } from '@/i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const locale = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(locale);
const { title = t('meta.title'), description = t('meta.description') } = Astro.props;

/** 去掉语言前缀后的规范路径，用于判断导航激活态。 */
const basePath = switchLangPath(Astro.url.pathname, defaultLang);
const L = (path: string) => localizePath(path, locale);
const nav = [
  { key: 'nav.now', href: '/#now', active: basePath === '/' },
  { key: 'nav.projects', href: '/#projects', active: basePath.startsWith('/projects') },
  { key: 'nav.games', href: '/#games', active: basePath.startsWith('/games') },
  { key: 'nav.library', href: '/library/', active: basePath.startsWith('/library') },
  { key: 'nav.tools', href: '/#tools', active: basePath.startsWith('/tools') },
  { key: 'nav.bookmarks', href: '/#bookmarks', active: false },
  { key: 'nav.writing', href: '/#writing', active: basePath.startsWith('/articles') },
  { key: 'nav.ideas', href: '/#ideas', active: basePath.startsWith('/ideas') },
  { key: 'nav.about', href: '/about/', active: basePath.startsWith('/about') },
] as const;
const langLinks = (Object.keys(languages) as Lang[]).map((lng) => ({
  lng,
  label: languages[lng],
  href: switchLangPath(Astro.url.pathname, lng),
}));
---
<!doctype html>
<html lang={locale} data-skin={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        try {
          const skin = JSON.parse(localStorage.getItem('bai-skin') || 'null');
          const theme = JSON.parse(localStorage.getItem('bai-theme') || 'null');
          if (skin) document.documentElement.dataset.skin = skin;
          if (theme === 'dark' || skin === 'terminal') document.documentElement.dataset.theme = 'dark';
        } catch {
          // Ignore storage restrictions and keep the default theme.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ece0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="白子诩" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {langLinks.map(({ lng, href }) => (
      <link rel="alternate" hreflang={lng} href={new URL(href, Astro.site)} />
    ))}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;900&family=Noto+Serif+SC:wght@500;700;900&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={L('/')} aria-label={t('footer.top')}>
          <span class="brand-mark"><img src="/assets/logo-mark.png" alt="" width="35" height="35" /></span>
          <span class="brand-copy"><strong>白子诩</strong><small>lab</small></span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {nav.map((item) => (
            <a class:list={{ active: item.active }} href={L(item.href)}>{t(item.key)}</a>
          ))}
        </nav>
        <div class="top-actions">
          <button class="icon-button" id="install-button" type="button" aria-label={t('install.label')} title={t('install.label')} hidden>
            <Download aria-hidden="true" />
          </button>
          <div class="search-wrap">
            <label class="search-box" for="site-search">
              <Search aria-hidden="true" />
              <input id="site-search" type="search" placeholder={t('search.placeholder')} autocomplete="off" />
              <kbd>/</kbd>
            </label>
            <div class="search-panel" id="search-panel" hidden></div>
          </div>
          <div class="skin-menu" id="skin-menu">
            <button class="icon-button" id="skin-button" type="button" aria-label={t('theme.skin')} title={t('theme.skin')} aria-haspopup="true" aria-expanded="false">
              <Palette aria-hidden="true" />
            </button>
            <div class="skin-panel" id="skin-panel" hidden>
              <p class="skin-panel-title">{t('theme.skin')}</p>
              {themes.map((option) => (
                <button class="skin-option" type="button" data-skin-option={option.id}>
                  <span class="skin-swatch" data-swatch={option.id} aria-hidden="true"></span>
                  <span class="skin-option-copy"><strong>{option.name}</strong><small>{option.description}</small></span>
                </button>
              ))}
            </div>
          </div>
          <div class="lang-menu" id="lang-menu">
            <button class="icon-button" id="lang-button" type="button" aria-label={t('lang.switch')} title={t('lang.switch')} aria-haspopup="true" aria-expanded="false">
              <Globe aria-hidden="true" />
            </button>
            <div class="skin-panel lang-panel" id="lang-panel" hidden>
              <p class="skin-panel-title">{t('lang.switch')}</p>
              {langLinks.map(({ lng, label, href }) => (
                <a class="skin-option lang-option" href={href} hreflang={lng} aria-current={lng === locale ? 'true' : undefined}>
                  <span class="skin-option-copy"><strong>{label}</strong><small>{lng.toUpperCase()}</small></span>
                  {lng === locale && <Check class="lang-check" aria-hidden="true" />}
                </a>
              ))}
            </div>
          </div>
          <button class="icon-button" id="theme-toggle" type="button" aria-label={t('theme.toggle.dark')} title={t('theme.toggle.dark')}>
            <Sun class="theme-sun" aria-hidden="true" />
            <Moon class="theme-moon" aria-hidden="true" />
          </button>
        </div>
      </header>
      <slot />
    </div>
    <ContactModal locale={locale} />
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/pwa.ts"></script>
  </body>
</html>
